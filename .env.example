# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN_BUILDER=http://localhost:5173
CORS_ORIGIN_ADMIN=http://localhost:5174
CORS_ORIGIN_PUBLIC=http://localhost:3000
# Production examples:
# CORS_ORIGIN_BUILDER=https://builder.verifiedprops.com
# CORS_ORIGIN_ADMIN=https://admin.verifiedprops.com
# CORS_ORIGIN_PUBLIC=https://verifiedprops.com

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/property_platform?schema=public"
# Used only by `docker compose up` to configure the postgres container itself
# and to build the api container's DATABASE_URL (see docker-compose.yml). Not
# read directly by the API. Keep these in sync with the credentials you want
# the compose-managed Postgres instance to use.
POSTGRES_USER=verifiedprops
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=property_platform

# JWT
JWT_ACCESS_SECRET=replace_with_strong_secret_min_32_chars_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_different_strong_secret_32chars
JWT_REFRESH_EXPIRY=7d

# OTP (customer login)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP (OTP + notification emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM="VerifiedProps <no-reply@example.com>"
# NOTE: swap the placeholder domain for the real one (e.g. no-reply@verifiedprops.com)
# once the sending domain is secured and verified.

# File storage (local placeholder)
# Storage driver: "local" or "s3"
STORAGE_DRIVER=local
FILE_UPLOAD_DIR=./uploads
# Legacy: the API now stores/serves origin-relative /uploads/... URLs, so each
# client builds the full URL from its own config. This value is only used as a
# fallback/normalization hint. Set it to the publicly reachable API URL if kept.
FILE_UPLOAD_BASE_URL=http://localhost:4000/uploads
FILE_MAX_SIZE_MB=10

# Public file URL for the Next.js web app (used by CSP, image optimization, and
# the fileUrl() helper). Must point to the API origin including /uploads path.
# Examples: http://localhost:4000/uploads  or  https://api.verifiedprops.com/uploads
NEXT_PUBLIC_FILE_BASE_URL=http://localhost:4000/uploads

# S3 storage (used when STORAGE_DRIVER=s3)
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for direct object URLs, e.g. https://cdn.example.com
S3_PUBLIC_BASE_URL=
# Optional (LocalStack/MinIO):
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Presigned URL lifetime in seconds
S3_URL_EXPIRES_IN_SECONDS=3600

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Admin seed
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!
