# =========================================================
# Production environment — single block only.
# Duplicate keys are undefined behaviour (loader-dependent). Never repeat a key.
# =========================================================

NODE_ENV=production
API_PORT=4000
WEB_PORT=3000

DATABASE_URL=postgresql://verifiedprops:change-me@127.0.0.1:5432/property_platform?schema=public

# Canonical origins (single value each — also used by mail templates & SEO).
CORS_ORIGIN_PUBLIC=https://www.example.com
CORS_ORIGIN_BUILDER=https://builder.example.com
CORS_ORIGIN_ADMIN=https://admin.example.com
# Optional extra origins, comma-separated (e.g. apex www-less domain, admin IP/port).
CORS_ORIGINS_EXTRA=https://example.com

# Web app — inlined at `next build` time (no /v1 here; the app adds it).
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_FILE_BASE_URL=https://api.example.com/uploads
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Server-side only (web -> API on the same host). 
API_INTERNAL_BASE_URL=http://127.0.0.1:4000

# Builder & admin portals — inlined at `vite build` time.
VITE_API_URL=https://api.example.com

DOMAIN_API=api.example.com
DOMAIN_WEB=www.example.com
DOMAIN_BUILDER=builder.example.com

JWT_ACCESS_SECRET=change-me-with-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-with-a-different-32-chars
JWT_REFRESH_EXPIRY=7d

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_FROM=PropertiesWale <no-reply@example.com>

STORAGE_DRIVER=local
FILE_UPLOAD_DIR=./uploads
FILE_UPLOAD_BASE_URL=https://api.example.com/uploads
FILE_MAX_SIZE_MB=10

THROTTLE_TTL=60
THROTTLE_LIMIT=120

ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!